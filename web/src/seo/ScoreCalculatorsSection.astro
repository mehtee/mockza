---
import {
  computeDetSubscores,
  estimateToeflLegacy120,
  readingBandFor,
} from '@mockza/domain';

export interface Props {
  isIrn?: boolean;
}

const { isIrn = false } = Astro.props;
const defaultIeltsBand = readingBandFor(30, 'academic').toFixed(1);
const defaultToefl120 = estimateToeflLegacy120(5.0);
const defaultDet = computeDetSubscores({
  reading: 125,
  listening: 120,
  writing: 115,
  speaking: 115,
});
---

<div
  data-testid="score-calculators-island"
  data-irn={isIrn ? 'true' : 'false'}
  class="grid gap-6 md:grid-cols-3 text-start"
>
  <section class="rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface p-5">
    <h2 class="text-base font-bold text-text-primary">
      {isIrn ? 'محاسبه نمره خام آیلتس (۰ تا ۴۰)' : 'IELTS Raw-to-Band Converter'}
    </h2>
    <div class="mt-3 flex flex-col gap-2 text-xs">
      <label for="calc-ielts-mode" class="text-text-secondary">
        {isIrn ? 'بخش آزمون' : 'Module Curve'}
      </label>
      <select
        id="calc-ielts-mode"
        data-testid="calc-ielts-mode"
        class="h-9 rounded-[var(--mz-radius-compact)] border border-border-subtle bg-canvas px-2 text-text-primary"
      >
        <option value="reading_acad" selected>Academic Reading</option>
        <option value="reading_gt">General Training Reading</option>
        <option value="listening">Listening</option>
      </select>

      <label
        for="calc-ielts-raw"
        data-testid="calc-ielts-raw-label"
        class="mt-2 text-text-secondary"
      >
        {isIrn ? 'تعداد پاسخ صحیح: 30' : 'Correct Answers: 30 / 40'}
      </label>
      <input
        id="calc-ielts-raw"
        data-testid="calc-ielts-raw"
        type="range"
        min="0"
        max="40"
        value="30"
        class="w-full accent-primary"
      />

      <div dir="ltr" class="contents">
        <p data-testid="calc-ielts-result" class="mt-2 font-mono-exam text-2xl font-bold text-primary">
          Band {defaultIeltsBand}
        </p>
      </div>
    </div>
  </section>

  <section class="rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface p-5">
    <h2 class="text-base font-bold text-text-primary">
      {isIrn ? 'تبدیل تافل ۲۰۲۶ (۶ به ۱۲۰)' : 'TOEFL iBT 2026 (1–6 to 0–120)'}
    </h2>
    <div class="mt-3 flex flex-col gap-2 text-xs">
      <label
        for="calc-toefl-band"
        data-testid="calc-toefl-label"
        class="text-text-secondary"
      >
        {isIrn ? 'نمره ۲۰۲۶: 5.0' : '2026 Band: 5.0 / 6.0'}
      </label>
      <input
        id="calc-toefl-band"
        data-testid="calc-toefl-band"
        type="range"
        min="1"
        max="6"
        step="0.5"
        value="5"
        class="w-full accent-primary"
      />

      <div dir="ltr" class="contents">
        <p data-testid="calc-toefl-result" class="mt-2 font-mono-exam text-2xl font-bold text-primary">
          ~{defaultToefl120} / 120
        </p>
      </div>
    </div>
  </section>

  <section class="rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface p-5">
    <h2 class="text-base font-bold text-text-primary">
      {isIrn ? 'شبیه‌ساز زیرمقیاس‌های DET' : 'DET 4-Subscore Simulator'}
    </h2>
    <div class="mt-3 grid grid-cols-2 gap-2 text-xs">
      <label class="flex flex-col gap-1">
        <span>Reading (<span data-testid="calc-det-reading-val">125</span>)</span>
        <input
          type="range"
          min="10"
          max="160"
          step="5"
          value="125"
          data-testid="calc-det-reading"
          class="accent-primary"
        />
      </label>
      <label class="flex flex-col gap-1">
        <span>Listening (<span data-testid="calc-det-listening-val">120</span>)</span>
        <input
          type="range"
          min="10"
          max="160"
          step="5"
          value="120"
          data-testid="calc-det-listening"
          class="accent-primary"
        />
      </label>
      <label class="flex flex-col gap-1">
        <span>Writing (<span data-testid="calc-det-writing-val">115</span>)</span>
        <input
          type="range"
          min="10"
          max="160"
          step="5"
          value="115"
          data-testid="calc-det-writing"
          class="accent-primary"
        />
      </label>
      <label class="flex flex-col gap-1">
        <span>Speaking (<span data-testid="calc-det-speaking-val">115</span>)</span>
        <input
          type="range"
          min="10"
          max="160"
          step="5"
          value="115"
          data-testid="calc-det-speaking"
          class="accent-primary"
        />
      </label>
    </div>

    <div dir="ltr" class="contents">
      <dl
        data-testid="calc-det-result"
        class="mt-3 grid grid-cols-2 gap-1.5 font-mono-exam text-xs font-semibold text-primary"
      >
        <div>Literacy: {defaultDet.literacy}</div>
        <div>Comp: {defaultDet.comprehension}</div>
        <div>Conv: {defaultDet.conversation}</div>
        <div>Prod: {defaultDet.production}</div>
      </dl>
    </div>
  </section>
</div>

<script>
  import '@/seo/score-calculators-client';
</script>
