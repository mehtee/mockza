---
import {
  computeDetSubscores,
  estimateToeflLegacy120,
  readingBandFor,
} from '@mockza/domain';

export interface Props {
  isIrn?: boolean;
}

const { isIrn = false } = Astro.props;
const faD = '۰۱۲۳۴۵۶۷۸۹';
const fmt = (v: string | number): string =>
  isIrn ? String(v).replace(/\d/g, (d) => faD[Number(d)] ?? d) : String(v);
const defaultIeltsBand = readingBandFor(30, 'academic').toFixed(1);
const defaultToefl120 = estimateToeflLegacy120(5.0);
const defaultDet = computeDetSubscores({
  reading: 125,
  listening: 120,
  writing: 115,
  speaking: 115,
});
---

<div
  data-testid="score-calculators-island"
  data-irn={isIrn ? 'true' : 'false'}
  class="grid gap-6 md:grid-cols-3 text-start"
>
  <section class="rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface p-5">
    <h2 class="text-base font-bold text-text-primary">
      {isIrn ? 'محاسبه نمره خام آیلتس (۰ تا ۴۰)' : 'IELTS Raw-to-Band Converter'}
    </h2>
    <div class="mt-3 flex flex-col gap-2 text-xs">
      <label for="calc-ielts-mode" class="text-text-secondary">
        {isIrn ? 'بخش آزمون' : 'Module Curve'}
      </label>
      <select
        id="calc-ielts-mode"
        data-testid="calc-ielts-mode"
        class="h-11 rounded-[var(--mz-radius-compact)] border border-border-subtle bg-canvas px-3 text-text-primary"
      >
        <option value="reading_acad" selected>
          {isIrn ? 'ریدینگ آکادمیک (Academic Reading)' : 'Academic Reading'}
        </option>
        <option value="reading_gt">
          {isIrn ? 'ریدینگ جنرال (General Training Reading)' : 'General Training Reading'}
        </option>
        <option value="listening">{isIrn ? 'لیسنینگ (Listening)' : 'Listening'}</option>
      </select>

      <label
        for="calc-ielts-raw"
        data-testid="calc-ielts-raw-label"
        class="mt-2 text-text-secondary"
      >
        {isIrn ? `تعداد پاسخ صحیح: ${fmt(30)}` : 'Correct Answers: 30 / 40'}
      </label>
      <input
        id="calc-ielts-raw"
        data-testid="calc-ielts-raw"
        type="range"
        min="0"
        max="40"
        value="30"
        class="w-full accent-primary"
      />

      <div dir={isIrn ? 'rtl' : 'ltr'} class="contents">
        <p data-testid="calc-ielts-result" class={`mt-2 ${isIrn ? '' : 'font-mono-exam '}text-2xl font-bold text-primary`}>
          {isIrn ? `باند ${fmt(defaultIeltsBand)}` : `Band ${defaultIeltsBand}`}
        </p>
      </div>
    </div>
  </section>

  <section class="rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface p-5">
    <h2 class="text-base font-bold text-text-primary">
      {isIrn ? 'تبدیل تافل ۲۰۲۶ (۶ به ۱۲۰)' : 'TOEFL iBT 2026 (1–6 to 0–120)'}
    </h2>
    <div class="mt-3 flex flex-col gap-2 text-xs">
      <label
        for="calc-toefl-band"
        data-testid="calc-toefl-label"
        class="text-text-secondary"
      >
        {isIrn ? `نمره ۲۰۲۶: ${fmt('5.0')}` : '2026 Band: 5.0 / 6.0'}
      </label>
      <input
        id="calc-toefl-band"
        data-testid="calc-toefl-band"
        type="range"
        min="1"
        max="6"
        step="0.5"
        value="5"
        class="w-full accent-primary"
      />

      <div dir={isIrn ? 'rtl' : 'ltr'} class="contents">
        <p data-testid="calc-toefl-result" class={`mt-2 ${isIrn ? '' : 'font-mono-exam '}text-2xl font-bold text-primary`}>
          {isIrn ? `~${fmt(defaultToefl120)} / ۱۲۰` : `~${defaultToefl120} / 120`}
        </p>
      </div>
    </div>
  </section>

  <section class="rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface p-5">
    <h2 class="text-base font-bold text-text-primary">
      {isIrn ? 'شبیه‌ساز زیرمقیاس‌های DET' : 'DET 4-Subscore Simulator'}
    </h2>
    <div class="mt-3 grid grid-cols-2 gap-2 text-xs">
      <label class="flex flex-col gap-1">
        <span>{isIrn ? 'ریدینگ' : 'Reading'} (<span data-testid="calc-det-reading-val">{fmt(125)}</span>)</span>
        <input
          type="range"
          min="10"
          max="160"
          step="5"
          value="125"
          data-testid="calc-det-reading"
          class="accent-primary"
        />
      </label>
      <label class="flex flex-col gap-1">
        <span>{isIrn ? 'لیسنینگ' : 'Listening'} (<span data-testid="calc-det-listening-val">{fmt(120)}</span>)</span>
        <input
          type="range"
          min="10"
          max="160"
          step="5"
          value="120"
          data-testid="calc-det-listening"
          class="accent-primary"
        />
      </label>
      <label class="flex flex-col gap-1">
        <span>{isIrn ? 'رایتینگ' : 'Writing'} (<span data-testid="calc-det-writing-val">{fmt(115)}</span>)</span>
        <input
          type="range"
          min="10"
          max="160"
          step="5"
          value="115"
          data-testid="calc-det-writing"
          class="accent-primary"
        />
      </label>
      <label class="flex flex-col gap-1">
        <span>{isIrn ? 'اسپیکینگ' : 'Speaking'} (<span data-testid="calc-det-speaking-val">{fmt(115)}</span>)</span>
        <input
          type="range"
          min="10"
          max="160"
          step="5"
          value="115"
          data-testid="calc-det-speaking"
          class="accent-primary"
        />
      </label>
    </div>

    <div dir={isIrn ? 'rtl' : 'ltr'} class="contents">
      <dl
        data-testid="calc-det-result"
        class={`mt-3 grid grid-cols-2 gap-1.5 ${isIrn ? '' : 'font-mono-exam '}text-xs font-semibold text-primary`}
      >
        <div>{isIrn ? `سواد: ${fmt(defaultDet.literacy)}` : `Literacy: ${defaultDet.literacy}`}</div>
        <div>{isIrn ? `درک: ${fmt(defaultDet.comprehension)}` : `Comp: ${defaultDet.comprehension}`}</div>
        <div>{isIrn ? `مکالمه: ${fmt(defaultDet.conversation)}` : `Conv: ${defaultDet.conversation}`}</div>
        <div>{isIrn ? `تولید: ${fmt(defaultDet.production)}` : `Prod: ${defaultDet.production}`}</div>
      </dl>
    </div>
  </section>
</div>

<script>
  import '@/seo/score-calculators-client';
</script>
