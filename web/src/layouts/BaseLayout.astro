---
import '../styles/global.css';
import {
  DEFAULT_THEME_MODE,
  DEFAULT_THEME_PRESET_ID,
  ZERO_FOUC_THEME_BOOT_SCRIPT,
} from '@/theme/theme-controller';

export interface Props {
  title?: string;
  description?: string;
}

const edition = import.meta.env.PUBLIC_EDITION === 'irn' ? 'irn' : 'glb';
const lang = edition === 'irn' ? 'fa-IR' : 'en-US';
const dir = edition === 'irn' ? 'rtl' : 'ltr';
const defaultTitle =
  edition === 'irn'
    ? 'سنجیا | شبیه‌ساز دسکتاپ آزمون‌های بین‌المللی زبان'
    : 'Mockza | Desktop English Exam Simulator';
const defaultDescription =
  edition === 'irn'
    ? 'شبیه‌ساز دسکتاپ آیلتس، تافل ۲۰۲۶، پی‌تی‌ای و دولینگو با ارزیابی هوشمند و مرور واژگان SM-2.'
    : 'Desktop simulator for IELTS Academic, IELTS General, TOEFL iBT 2026, PTE Academic, and Duolingo English Test.';

const { title = defaultTitle, description = defaultDescription } = Astro.props;
---

<!doctype html>
<html
  lang={lang}
  dir={dir}
  data-theme={DEFAULT_THEME_PRESET_ID}
  data-mode={DEFAULT_THEME_MODE}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline set:html={ZERO_FOUC_THEME_BOOT_SCRIPT} />
  </head>
  <body class="bg-canvas text-text-primary antialiased">
    <slot />
  </body>
</html>
