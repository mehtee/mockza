---
import { createHash } from 'node:crypto';
import '../styles/global.css';
import '@@edition-fonts.css';
import { getActiveEditionConfig } from '@/edition/edition-config';
import { getPublicSiteCopyForBuild } from '@/seo/public-catalog';
import {
  DEFAULT_THEME_MODE,
  DEFAULT_THEME_PRESET_ID,
  ZERO_FOUC_THEME_BOOT_SCRIPT,
} from '@/theme/theme-controller';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImagePath?: string;
  markdownTwinPath?: string;
  jsonLd?: Record<string, unknown> | readonly Record<string, unknown>[];
  showPublicNav?: boolean;
  sampleNavigation?: boolean;
}

const editionConfig = getActiveEditionConfig();
const siteCopy = getPublicSiteCopyForBuild();
const isIrn = editionConfig.edition === 'irn';
const lang = isIrn ? 'fa' : 'en';
const dir = editionConfig.dir;
const fontClass = isIrn ? 'font-fa' : 'font-en';
const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : `https://${editionConfig.domain}`;
const defaultTitle = isIrn
  ? 'سنجیا | شبیه‌ساز دسکتاپ آزمون‌های بین‌المللی زبان'
  : 'Mockza | Desktop English Exam Simulator';
const defaultDescription = siteCopy.heroSubtitle;

const {
  title = defaultTitle,
  description = defaultDescription,
  canonicalPath,
  ogImagePath,
  markdownTwinPath,
  jsonLd,
  showPublicNav = false,
  sampleNavigation = false,
} = Astro.props;

const canonicalUrl = canonicalPath ? `${siteOrigin}${canonicalPath}` : undefined;
const ogImageUrl = ogImagePath ? `${siteOrigin}${ogImagePath}` : `${siteOrigin}/og/home.png`;
const themeBootVersion = createHash('sha256').update(ZERO_FOUC_THEME_BOOT_SCRIPT).digest('hex').slice(0, 12);
---

<!doctype html>
<html
  lang={lang}
  dir={dir}
  data-theme={DEFAULT_THEME_PRESET_ID}
  data-mode={DEFAULT_THEME_MODE}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    {markdownTwinPath ? (
      <link rel="alternate" type="text/markdown" href={markdownTwinPath} />
    ) : null}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {jsonLd ? (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    ) : null}
    <script is:inline src={`/theme-boot.js?v=${themeBootVersion}`}></script>
  </head>
  <body class={`bg-canvas text-text-primary antialiased ${fontClass}`}>
    {showPublicNav ? (
      <header class:list={['border-b border-border-subtle bg-canvas', sampleNavigation && 'sticky top-0 z-20']}>
        <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-3 px-5 py-4 sm:px-6">
          <a href="/" class="inline-flex items-center gap-2.5 text-lg font-bold text-text-primary">
            <svg width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true" class="shrink-0 text-primary">
              <rect x="1" y="1" width="30" height="30" rx="8.5" fill="currentColor" fill-opacity="0.1" stroke="currentColor" stroke-opacity="0.22" stroke-width="1.25" />
              {isIrn ? (
                <>
                  <path d="M8.5 11.25v3a3.25 3.25 0 0 0 3.25 3.25h8.5a3.25 3.25 0 0 0 3.25-3.25v-3" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M16 9.5v8" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" />
                  <path d="M12.25 20.5h7.5L16 26.25l-3.75-5.75Z" fill="currentColor" />
                  <circle cx="16" cy="22.15" r="0.95" fill="white" />
                </>
              ) : (
                <>
                  <path d="M8.75 21.75V10.75l7.25 6.5 7.25-6.5v11" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" />
                  <circle cx="16" cy="23.25" r="1.6" fill="currentColor" />
                </>
              )}
            </svg>
            {siteCopy.brandTitle}
          </a>
          <nav aria-label={isIrn ? 'ناوبری سایت' : 'Public navigation'} class="flex order-last w-full flex-nowrap items-center gap-4 overflow-x-auto no-scrollbar pb-1 text-sm font-medium text-text-secondary sm:order-none sm:w-auto sm:flex-wrap sm:overflow-visible sm:pb-0 sm:gap-6">
            {sampleNavigation ? (
              <>
                <a class="inline-flex min-h-11 shrink-0 items-center whitespace-nowrap" href="#sample-report">{isIrn ? 'گزارش نمونه' : 'Sample report'}</a>
                <a class="inline-flex min-h-11 shrink-0 items-center whitespace-nowrap" href="#ai-feedback">{isIrn ? 'بازخورد هوش مصنوعی' : 'AI feedback'}</a>
                <a class="inline-flex min-h-11 shrink-0 items-center whitespace-nowrap" href="#study-tools">{isIrn ? 'ابزارهای مطالعه' : 'Study tools'}</a>
              </>
            ) : (
              <>
                <a class="inline-flex min-h-11 shrink-0 items-center whitespace-nowrap" href="/calculators">{siteCopy.navCalculators}</a>
                <a class="inline-flex min-h-11 shrink-0 items-center whitespace-nowrap" href="/samples">{siteCopy.navSamples}</a>
                <a class="inline-flex min-h-11 shrink-0 items-center whitespace-nowrap" href="/vocab">{siteCopy.navVocab}</a>
              </>
            )}
          </nav>
          <a href="/app/" class="inline-flex min-h-11 items-center whitespace-nowrap rounded-[var(--mz-radius-compact)] bg-primary px-4 text-sm font-semibold text-on-primary hover:bg-primary-pressed">
            {siteCopy.navOpenApp}
          </a>
        </div>
      </header>
    ) : null}
    <slot />
    {showPublicNav ? (
      <footer class="border-t border-border-subtle bg-bg-raised py-8 text-xs text-text-secondary">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6">
          <p>{siteCopy.brandTitle} · {editionConfig.domain}</p>
          <div class="flex flex-wrap items-center gap-4">
            <a href="/ielts-academic" class="inline-flex min-h-10 items-center hover:text-text-primary">IELTS Academic</a>
            <a href="/ielts-general" class="inline-flex min-h-10 items-center hover:text-text-primary">IELTS General</a>
            <a href="/toefl-ibt" class="inline-flex min-h-10 items-center hover:text-text-primary">TOEFL iBT 2026</a>
            <a href="/pte-academic" class="inline-flex min-h-10 items-center hover:text-text-primary">PTE Academic</a>
            <a href="/duolingo-english-test" class="inline-flex min-h-10 items-center hover:text-text-primary">DET</a>
            <a href="/llms.txt" class="inline-flex min-h-10 items-center hover:text-text-primary">llms.txt</a>
          </div>
        </div>
      </footer>
    ) : null}
  </body>
</html>
