---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getActiveEditionConfig } from '@/edition/edition-config';
import { getExamPillarsForBuild, getPublicSiteCopyForBuild } from '@/seo/public-catalog';

export function getStaticPaths() {
  return getExamPillarsForBuild().map((guide) => ({
    params: { examSlug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const editionConfig = getActiveEditionConfig();
const isIrn = editionConfig.edition === 'irn';
const copy = getPublicSiteCopyForBuild();

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const courseJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: guide.headline,
  description: guide.summary,
  provider: {
    '@type': 'Organization',
    name: copy.brandTitle,
    url: `https://${editionConfig.domain}`,
  },
};

const quizJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Quiz',
  name: `${guide.name} Diagnostic Practice`,
  about: guide.name,
  educationalAlignment: {
    '@type': 'AlignmentObject',
    alignmentType: 'educationalSubject',
    targetName: guide.scoreScaleLabel,
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: copy.navHome,
      item: `https://${editionConfig.domain}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: guide.name,
      item: `https://${editionConfig.domain}/${guide.slug}`,
    },
  ],
};
---

<BaseLayout
  title={`${guide.name} | ${copy.brandTitle}`}
  description={guide.summary}
  canonicalPath={`/${guide.slug}`}
  ogImagePath={`/og/${guide.slug}.png`}
  markdownTwinPath={`/${guide.slug}.md`}
  jsonLd={[courseJsonLd, faqJsonLd, quizJsonLd, breadcrumbJsonLd]}
  showPublicNav
>
  <main class="mx-auto flex max-w-5xl flex-col gap-8 px-6 py-12 text-start">
    <section class="rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface p-6 sm:p-8">
      <div class="flex flex-wrap items-center gap-2 text-xs font-bold">
        <span class="rounded-[var(--mz-radius-pill)] bg-surface-alt px-3 py-1 text-primary">
          {guide.scoreScaleLabel}
        </span>
        <span class="rounded-[var(--mz-radius-pill)] border border-border-subtle bg-bg-raised px-3 py-1 text-text-secondary">
          {guide.durationLabel}
        </span>
      </div>
      <h1 class="mt-2.5 text-2xl sm:text-3xl font-bold text-text-primary">{guide.headline}</h1>
      <p class="mt-3 text-sm leading-relaxed text-text-secondary">{guide.summary}</p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={`/app/diagnostic/intro?track=${guide.examId}`}
          class="inline-flex min-h-11 items-center rounded-[var(--mz-radius-control)] bg-primary px-5 text-xs font-semibold text-on-primary hover:bg-primary-pressed"
        >
          {copy.ctaDiagnostic}
        </a>
        <a
          href={`/app/practice?track=${guide.examId}`}
          class="inline-flex min-h-11 items-center rounded-[var(--mz-radius-control)] border border-border-subtle bg-bg-raised px-5 text-xs font-semibold text-text-primary hover:bg-surface-hover"
        >
          {copy.ctaCatalog}
        </a>
      </div>
    </section>

    <aside
      aria-label={copy.keyFactsHeading}
      class="rounded-[var(--mz-radius-card)] border border-border-subtle bg-bg-raised p-6"
    >
      <h2 class="text-sm font-bold text-primary">{copy.keyFactsHeading}</h2>
      <dl class="mt-3 grid gap-4 sm:grid-cols-2">
        {guide.keyFacts.map((fact) => (
          <div>
            <dt class="text-xs text-text-tertiary">{fact.label}</dt>
            <dd class="mt-0.5 text-sm font-semibold text-text-primary">{fact.value}</dd>
          </div>
        ))}
      </dl>
    </aside>

    <section class="rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface p-6">
      <h2 class="text-lg font-bold text-text-primary">
        {isIrn ? 'ساختار بخش‌ها و جریان آزمون' : 'Exam Format & Section Flow'}
      </h2>
      <ul class="mt-3 space-y-2 text-sm text-text-secondary">
        {guide.sectionsSummary.map((line) => (
          <li class="border-s-2 border-primary ps-3">{line}</li>
        ))}
      </ul>
      <p class="mt-4 rounded-[var(--mz-radius-compact)] bg-surface-alt p-3 text-xs text-text-primary">
        {guide.desktopAdvantage}
      </p>
    </section>

    <section class="rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface p-6">
      <h2 class="text-lg font-bold text-text-primary">
        {isIrn ? 'پرسش‌های پرتکرار' : 'Frequently Asked Questions'}
      </h2>
      <dl class="mt-4 space-y-4">
        {guide.faqs.map((faq) => (
          <div class="border-b border-border-subtle pb-3 last:border-b-0">
            <dt class="text-sm font-bold text-text-primary">{faq.question}</dt>
            <dd class="mt-1 text-xs leading-relaxed text-text-secondary">{faq.answer}</dd>
          </div>
        ))}
      </dl>
    </section>
  </main>
</BaseLayout>
