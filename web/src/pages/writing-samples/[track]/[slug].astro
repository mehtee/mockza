---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getActiveEditionConfig } from '@/edition/edition-config';
import { getPublicSiteCopyForBuild } from '@/seo/public-catalog';
import { WRITING_SAMPLES_CATALOG, type WritingSampleEntry } from '@/seo/programmatic-catalog';

export function getStaticPaths() {
  return WRITING_SAMPLES_CATALOG.map((sample) => ({
    params: { track: sample.trackSlug, slug: sample.slug },
    props: { sample },
  }));
}

interface Props {
  sample: WritingSampleEntry;
}

const { sample } = Astro.props;
const editionConfig = getActiveEditionConfig();
const isIrn = editionConfig.edition === 'irn';
const copy = getPublicSiteCopyForBuild();

const title = isIrn
  ? `${sample.titleFa} | ${copy.brandTitle}`
  : `${sample.title} (${sample.scoreBadge}) | ${copy.brandTitle}`;
const description = isIrn ? sample.examinerNoteFa : sample.examinerNoteEn;
const canonicalPath = `/writing-samples/${sample.trackSlug}/${sample.slug}`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: copy.navHome, item: `https://${editionConfig.domain}/` },
    { '@type': 'ListItem', position: 2, name: copy.navSamples, item: `https://${editionConfig.domain}/samples` },
    { '@type': 'ListItem', position: 3, name: isIrn ? sample.titleFa : sample.title, item: `https://${editionConfig.domain}${canonicalPath}` },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogImagePath={`/og/${sample.trackSlug}.png`}
  jsonLd={breadcrumbJsonLd}
  showPublicNav
>
  <main class="mx-auto flex max-w-4xl flex-col gap-6 px-6 py-12 text-start">
    <div class="text-xs text-text-secondary">
      <a href="/samples" class="hover:text-primary">{copy.navSamples}</a>
      <span class="mx-1.5">/</span>
      <a href={`/${sample.trackSlug}`} class="hover:text-primary">{sample.taskLabel}</a>
    </div>

    <header class="rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface p-6">
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-bold">
        <span class="text-primary">{sample.taskLabel}</span>
        <span class="rounded-[var(--mz-radius-pill)] bg-mint-bg px-3 py-0.5 text-success">
          {sample.scoreBadge}
        </span>
      </div>
      <h1 class="mt-2 text-2xl font-bold text-text-primary">
        {isIrn ? sample.titleFa : sample.title}
      </h1>
      <p dir="ltr" lang="en" class="mt-3 rounded-[var(--mz-radius-compact)] bg-bg-raised p-3 text-xs text-text-secondary text-start">
        {sample.prompt}
      </p>
    </header>

    <section class="rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface p-6">
      <h2 class="text-sm font-bold text-primary">
        {isIrn ? 'متن نمونه استاندارد مصحح' : 'Annotated High-Band Model Response'}
      </h2>
      <p
        dir="ltr"
        lang="en"
        class="mt-3 whitespace-pre-wrap rounded-[var(--mz-radius-control)] border border-border-subtle bg-canvas p-4 text-sm leading-relaxed text-text-primary text-start"
      >
        {sample.modelResponse}
      </p>
      <p class="mt-4 text-xs leading-relaxed text-text-secondary">
        {isIrn ? sample.examinerNoteFa : sample.examinerNoteEn}
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        {sample.upgradedTerms.map((term) => (
          <span
            dir="ltr"
            lang="en"
            class="rounded-[var(--mz-radius-pill)] border border-border-subtle bg-bg-raised px-2.5 py-0.5 font-mono-exam text-xs text-primary"
          >
            {term}
          </span>
        ))}
      </div>
    </section>

    <div class="flex flex-wrap gap-3">
      <a
        href={`/app/practice?track=${sample.examId}`}
        class="inline-flex h-10 items-center rounded-[var(--mz-radius-control)] bg-primary px-5 text-xs font-semibold text-on-primary hover:bg-primary-pressed"
      >
        {copy.ctaCatalog}
      </a>
    </div>
  </main>
</BaseLayout>
