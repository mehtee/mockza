---
import { getActiveEditionConfig } from '@/edition/edition-config';
import BaseLayout from '@/layouts/BaseLayout.astro';

export function getStaticPaths() {
  const slugs: Array<string | undefined> = [
    undefined,
    'welcome',
    'onboarding/goal',
    'diagnostic/intro',
    'diagnostic/session',
    'diagnostic/result',
    'auth/login',
    'home',
    'practice',
    'practice/drills',
    'practice/full-mock',
    'vocabulary',
    'vocabulary/review',
    'progress',
    'progress/compare',
    'settings',
    'paywall',
  ];

  return slugs.map((slug) => ({
    params: { slug },
  }));
}

const edition = getActiveEditionConfig();
const isIrn = edition.code === 'irn';
const navPlaceholders = isIrn
  ? ['خانه', 'تمرین', 'واژگان', 'پیشرفت', 'اشتراک ویژه', 'تنظیمات']
  : ['Home', 'Practice', 'Vocabulary', 'Progress', 'Pro Plans', 'Settings'];
---

<BaseLayout>
  <div id="mockza-spa-root">
    <!-- Static App Shell: painted immediately on HTML arrival before JS executes (0ms blank screen) -->
    <div dir={edition.dir} class="flex min-h-dvh bg-canvas text-text-primary">
      <aside
        aria-hidden="true"
        class="hidden w-64 shrink-0 flex-col border-e border-border-subtle bg-bg-raised px-3 py-4 lg:flex"
      >
        <div class="flex items-center justify-between px-2 py-1">
          <span class="text-base font-bold tracking-tight text-primary">{edition.brandName}</span>
        </div>
        <div class="mt-4 flex flex-col gap-1 text-sm text-text-secondary">
          {
            navPlaceholders.map((label) => (
              <div class="flex items-center gap-2.5 rounded-[var(--mz-radius-compact)] px-3 py-2 opacity-70">
                <span class="h-4 w-4 shrink-0 rounded bg-surface-alt" />
                <span>{label}</span>
              </div>
            ))
          }
        </div>
      </aside>
      <div class="flex min-w-0 flex-1 flex-col">
        <header
          aria-hidden="true"
          class="flex items-center justify-between gap-3 border-b border-border-subtle bg-bg-raised px-4 py-2.5 sm:px-6"
        >
          <div class="h-8 w-40 rounded-[var(--mz-radius-compact)] border border-border-subtle bg-surface" />
          <div class="flex items-center gap-2">
            <div class="h-7 w-24 rounded-[var(--mz-radius-pill)] border border-border-subtle bg-surface" />
            <div class="h-8 w-8 rounded-[var(--mz-radius-compact)] border border-border-subtle bg-surface" />
          </div>
        </header>
        <main class="mx-auto w-full max-w-[1440px] flex-1 p-6">
          <div class="mx-auto flex max-w-6xl animate-pulse flex-col gap-5 pb-10">
            <div class="h-16 rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface" />
            <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
              <div class="h-40 rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface" />
              <div class="h-40 rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface" />
              <div class="h-40 rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface" />
            </div>
          </div>
        </main>
      </div>
    </div>
  </div>
  <script>
    import '@/spa/mount-app';
  </script>
</BaseLayout>
