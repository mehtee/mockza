---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getActiveEditionConfig } from '@/edition/edition-config';
import { landingFaqEntries, renderLanding } from '@/landing/markup.mjs';
import interactions from '@/landing/interactions.js?url&no-inline';
import '@/landing/landing.css';

const edition = getActiveEditionConfig();
const irn = edition.edition === 'irn';
const title = irn ? 'تمرین آزمون زبان و بازخورد مهارت‌ها' : 'English exam practice and feedback';
const description = irn
  ? 'بازخورد نمونهٔ چهار مهارت را ببین، تعیین سطح انجام بده و برای آزمون زبان تمرین کن.'
  : 'Explore worked Reading, Listening, Writing and Speaking feedback, check your level, and practise the formats on your English exam.';
const faqs = landingFaqEntries(irn);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: edition.brandName,
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web',
    url: `https://${edition.domain}/`,
    description,
    inLanguage: irn ? 'fa-IR' : 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout
  title={`${edition.brandName} | ${title}`}
  description={description}
  canonicalPath="/"
  markdownTwinPath="/index.md"
  jsonLd={jsonLd}
  showPublicNav
  sampleNavigation
>
  <Fragment set:html={renderLanding(irn)} />
  <script type="module" src={interactions} is:inline></script>
</BaseLayout>
