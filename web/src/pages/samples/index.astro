---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getActiveEditionConfig } from '@/edition/edition-config';
import { getPublicSiteCopyForBuild, getSampleEssaysForBuild } from '@/seo/public-catalog';

const editionConfig = getActiveEditionConfig();
const isIrn = editionConfig.edition === 'irn';
const copy = getPublicSiteCopyForBuild();
const samples = getSampleEssaysForBuild();
---

<BaseLayout
  title={
    isIrn
      ? `نمونه رایتینگ نمره ۸.۵ آیلتس و ۶ تافل با تحلیل مصحح | ${copy.brandTitle}`
      : `Annotated High-Band Sample Essays (IELTS 8.5 & TOEFL 6.0) | ${copy.brandTitle}`
  }
  description={copy.heroSubtitle}
  canonicalPath="/samples"
  showPublicNav
>
  <main class="mx-auto flex max-w-5xl flex-col gap-6 px-6 py-12 text-start">
    <div>
      <h1 class="text-3xl font-bold text-text-primary">
        {isIrn ? 'بانک نمونه رایتینگ و بازنویسی استاندارد' : 'Annotated Model Response Bank'}
      </h1>
      <p class="mt-2 text-sm text-text-secondary">
        {isIrn
          ? 'نمونه‌های تالیفی با تحلیل معیارها و واژگان ارتقایافته — آماده تمرین در محیط دسکتاپ.'
          : 'Study clean-room high-scoring model responses alongside examiner rubric rationales.'}
      </p>
    </div>

    <div class="grid gap-5">
      {samples.map((item) => (
        <article class="rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface p-6">
          <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-bold">
            <span class="text-primary">{item.examLabel}</span>
            <span class="rounded-[var(--mz-radius-pill)] bg-mint-bg px-3 py-0.5 text-success">
              {item.scoreBadge}
            </span>
          </div>
          <h2 class="mt-2 text-lg font-bold text-text-primary">{item.promptTitle}</h2>
          <p
            dir="ltr"
            lang="en"
            class="mt-3 rounded-[var(--mz-radius-control)] border border-border-subtle bg-canvas p-4 text-sm leading-relaxed text-text-primary text-start"
          >
            {item.excerpt}
          </p>
          <p class="mt-3 text-xs leading-relaxed text-text-secondary">{item.examinerNote}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {item.upgradedTerms.map((term) => (
              <span class="rounded-[var(--mz-radius-pill)] border border-border-subtle bg-bg-raised px-2.5 py-0.5 font-mono-exam text-xs text-primary">
                {term}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <div>
      <a
        href="/app/practice"
        class="inline-flex h-10 items-center rounded-[var(--mz-radius-control)] bg-primary px-5 text-xs font-semibold text-on-primary hover:bg-primary-strong"
      >
        {copy.ctaCatalog}
      </a>
    </div>
  </main>
</BaseLayout>
