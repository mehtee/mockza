---
import { estimateToeflLegacy120, readingBandFor } from '@mockza/domain';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getActiveEditionConfig } from '@/edition/edition-config';
import ScoreCalculatorsSection from '@/seo/ScoreCalculatorsSection.astro';
import { getPublicSiteCopyForBuild } from '@/seo/public-catalog';

const editionConfig = getActiveEditionConfig();
const isIrn = editionConfig.edition === 'irn';
const copy = getPublicSiteCopyForBuild();

const toeflRows = [6.0, 5.5, 5.0, 4.5, 4.0, 3.5, 3.0, 2.5].map((band) => ({
  band: band.toFixed(1),
  legacy120: estimateToeflLegacy120(band),
}));

const ieltsRows = [40, 38, 35, 33, 30, 27, 23].map((raw) => ({
  raw,
  acad: readingBandFor(raw, 'academic').toFixed(1),
  gt: readingBandFor(raw, 'general_training').toFixed(1),
}));

const title = isIrn
  ? `ماشین‌حساب رسمی نمره آیلتس، تافل ۲۰۲۶ و دولینگو | ${copy.brandTitle}`
  : `Interactive IELTS, TOEFL 2026 & DET Score Calculators | ${copy.brandTitle}`;
---

<BaseLayout
  title={title}
  description={copy.heroSubtitle}
  canonicalPath="/calculators"
  markdownTwinPath="/calculators/toefl-6-to-120-converter.md"
  showPublicNav
>
  <main class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-12 text-start">
    <section>
      <h1 class="text-3xl font-bold text-text-primary">
        {isIrn ? 'ماشین‌حساب تعاملی تبدیل نمرات زبان' : 'Interactive Exam Score Calculators'}
      </h1>
      <p class="mt-2 text-sm text-text-secondary">
        {isIrn
          ? 'محاسبه دقیق با همان موتور استاندارد @mockza/domain داخل شبیه‌ساز دسکتاپ و اپلیکیشن.'
          : 'Computed deterministically using the exact domain scoring tables powering the simulator.'}
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href="/calculators/toefl-6-to-120-converter"
          class="inline-flex h-9 items-center rounded-[var(--mz-radius-compact)] border border-border-subtle bg-bg-raised px-4 text-xs font-semibold text-text-primary hover:bg-surface-hover"
        >
          {isIrn ? 'جدول کامل تبدیل تافل ۶ به ۱۲۰' : 'Dedicated TOEFL 1–6 to 0–120 Guide'}
        </a>
        <a
          href="/app/diagnostic/intro"
          class="inline-flex h-9 items-center rounded-[var(--mz-radius-compact)] bg-primary px-4 text-xs font-semibold text-on-primary hover:bg-primary-strong"
        >
          {copy.ctaDiagnostic}
        </a>
      </div>
    </section>

    <ScoreCalculatorsSection isIrn={isIrn} />

    <!-- Static crawlable concordance matrices (zero-JS fallback & GEO grounding) -->
    <section class="grid gap-6 md:grid-cols-2">
      <div class="rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface p-5">
        <h2 class="text-sm font-bold text-primary">TOEFL iBT 2026 Concordance</h2>
        <table class="mt-3 w-full text-xs">
          <thead>
            <tr class="border-b border-border-subtle text-text-tertiary">
              <th class="py-1.5 text-start">2026 Band (1–6)</th>
              <th class="py-1.5 text-end">Est. 0–120</th>
            </tr>
          </thead>
          <tbody>
            {toeflRows.map((row) => (
              <tr class="border-b border-border-subtle/50">
                <td class="py-1.5 font-mono-exam">{row.band}</td>
                <td class="py-1.5 text-end font-mono-exam font-semibold text-primary">
                  {row.legacy120}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface p-5">
        <h2 class="text-sm font-bold text-primary">IELTS Reading Raw Score Reference</h2>
        <table class="mt-3 w-full text-xs">
          <thead>
            <tr class="border-b border-border-subtle text-text-tertiary">
              <th class="py-1.5 text-start">Raw (/40)</th>
              <th class="py-1.5 text-end">Academic Band</th>
              <th class="py-1.5 text-end">General Training</th>
            </tr>
          </thead>
          <tbody>
            {ieltsRows.map((row) => (
              <tr class="border-b border-border-subtle/50">
                <td class="py-1.5 font-mono-exam">{row.raw}</td>
                <td class="py-1.5 text-end font-mono-exam font-semibold text-primary">{row.acad}</td>
                <td class="py-1.5 text-end font-mono-exam">{row.gt}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</BaseLayout>
