---
import { listeningBandFor, readingBandFor } from '@mockza/domain';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getActiveEditionConfig } from '@/edition/edition-config';
import ScoreCalculatorsSection from '@/seo/ScoreCalculatorsSection.astro';
import { getPublicSiteCopyForBuild } from '@/seo/public-catalog';

const editionConfig = getActiveEditionConfig();
const isIrn = editionConfig.edition === 'irn';
const copy = getPublicSiteCopyForBuild();

const rows = [40, 39, 37, 35, 33, 30, 27, 23, 20, 16].map((raw) => ({
  raw,
  listening: listeningBandFor(raw).toFixed(1),
  acad: readingBandFor(raw, 'academic').toFixed(1),
  gt: readingBandFor(raw, 'general_training').toFixed(1),
}));

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: copy.navHome, item: `https://${editionConfig.domain}/` },
    { '@type': 'ListItem', position: 2, name: copy.navCalculators, item: `https://${editionConfig.domain}/calculators` },
    { '@type': 'ListItem', position: 3, name: isIrn ? 'ماشین‌حساب نمره آیلتس' : 'IELTS Band Calculator', item: `https://${editionConfig.domain}/calculators/ielts-band-calculator` },
  ],
};
---

<BaseLayout
  title={
    isIrn
      ? `ماشین‌حساب رسمی نمره آیلتس (آکادمیک، جنرال و لیسنینگ) | ${copy.brandTitle}`
      : `IELTS Band Score Calculator (Listening, Academic & GT Reading) | ${copy.brandTitle}`
  }
  description={
    isIrn
      ? 'تبدیل دقیق تعداد پاسخ صحیح (از ۴۰) به نمره آیلتس ۰ تا ۹ برای لیسنینگ، ریدینگ آکادمیک و جنرال.'
      : 'Convert raw correct counts (/40) into official IELTS 0.0–9.0 band scores across Listening, Academic Reading, and General Training.'
  }
  canonicalPath="/calculators/ielts-band-calculator"
  jsonLd={breadcrumbJsonLd}
  showPublicNav
>
  <main class="mx-auto flex max-w-5xl flex-col gap-8 px-6 py-12 text-start">
    <section class="rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface p-6">
      <h1 class="text-2xl font-bold text-text-primary">
        {isIrn ? 'ماشین‌حساب نمره خام به بند آیلتس (۰.۰ تا ۹.۰)' : 'IELTS Raw-to-Band Score Calculator'}
      </h1>
      <p class="mt-2 text-sm text-text-secondary">
        {isIrn
          ? 'جدول و ابزار تبدیل دقیق پاسخ‌های صحیح از ۴۰ پرسش بر اساس منحنی رسمی آکادمیک و جنرال.'
          : 'Compare IELTS Listening, Academic Reading, and General Training raw score thresholds using the exact engine curve.'}
      </p>
      <table class="mt-4 w-full text-xs">
        <thead>
          <tr class="border-b border-border-subtle text-text-tertiary">
            <th class="py-2 text-start">{isIrn ? 'تعداد صحیح (/۴۰)' : 'Correct (/40)'}</th>
            <th class="py-2 text-end">{isIrn ? 'لیسنینگ' : 'Listening'}</th>
            <th class="py-2 text-end">{isIrn ? 'ریدینگ آکادمیک' : 'Acad. Reading'}</th>
            <th class="py-2 text-end">{isIrn ? 'ریدینگ جنرال' : 'GT Reading'}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-b border-border-subtle/50">
              <td class="py-2 font-mono-exam">{r.raw} / 40</td>
              <td class="py-2 text-end font-mono-exam font-semibold text-primary">{r.listening}</td>
              <td class="py-2 text-end font-mono-exam font-semibold text-primary">{r.acad}</td>
              <td class="py-2 text-end font-mono-exam font-semibold text-text-secondary">{r.gt}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <ScoreCalculatorsSection isIrn={isIrn} />
  </main>
</BaseLayout>
