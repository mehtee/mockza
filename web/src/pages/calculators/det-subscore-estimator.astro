---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getActiveEditionConfig } from '@/edition/edition-config';
import ScoreCalculatorsSection from '@/seo/ScoreCalculatorsSection.astro';
import { getPublicSiteCopyForBuild } from '@/seo/public-catalog';

const editionConfig = getActiveEditionConfig();
const isIrn = editionConfig.edition === 'irn';
const copy = getPublicSiteCopyForBuild();

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: copy.navHome, item: `https://${editionConfig.domain}/` },
    { '@type': 'ListItem', position: 2, name: copy.navCalculators, item: `https://${editionConfig.domain}/calculators` },
    { '@type': 'ListItem', position: 3, name: 'DET Subscore Estimator', item: `https://${editionConfig.domain}/calculators/det-subscore-estimator` },
  ],
};
---

<BaseLayout
  title={
    isIrn
      ? `محاسبه ۴ زیرنمره آزمون دولینگو (DET 10–160) | ${copy.brandTitle}`
      : `Duolingo English Test (DET) 4-Subscore Estimator (10–160) | ${copy.brandTitle}`
  }
  description={
    isIrn
      ? 'محاسبه دقیق زیرنمرات Literacy، Comprehension، Conversation و Production بر پایه مقیاس ۱۰ تا ۱۶۰.'
      : 'Calculate DET Literacy, Comprehension, Conversation, and Production integrated subscores from your 4 skill scores.'
  }
  canonicalPath="/calculators/det-subscore-estimator"
  jsonLd={breadcrumbJsonLd}
  showPublicNav
>
  <main class="mx-auto flex max-w-5xl flex-col gap-8 px-6 py-12 text-start">
    <section class="rounded-[var(--mz-radius-card)] border border-border-subtle bg-surface p-6">
      <h1 class="text-2xl font-bold text-text-primary">
        {isIrn ? 'محاسبه‌گر ۴ زیرنمره آزمون دولینگو (DET)' : 'Duolingo English Test 4-Subscore Estimator'}
      </h1>
      <p class="mt-2 text-sm leading-relaxed text-text-secondary">
        {isIrn
          ? 'نمره کل دولینگو بین ۱۰ تا ۱۶۰ (با گام ۵ واحدی) از میانگین چهار زیرمقیاس ترکیبی محاسبه می‌شود: Literacy (خواندن+نوشتن)، Comprehension (خواندن+شنیدن)، Conversation (شنیدن+صحبت) و Production (نوشتن+صحبت).'
          : 'DET reports an overall 10–160 score (5-point quantized) derived from four integrated pairs: Literacy (Reading + Writing), Comprehension (Reading + Listening), Conversation (Listening + Speaking), and Production (Writing + Speaking).'}
      </p>
    </section>

    <ScoreCalculatorsSection isIrn={isIrn} />
  </main>
</BaseLayout>
