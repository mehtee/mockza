{
  "name": "@mockza/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx src/export-openapi.ts --write",
    "typecheck": "tsc --noEmit",
    "openapi": "tsx src/export-openapi.ts",
    "openapi:export": "tsx src/export-openapi.ts --write",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.19.6",
    "zod": "^3.25.0"
  }
}
