{
  "name": "@mockza/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"import('node:fs').then(fs=>{if(fs.existsSync('src/migrations'))fs.cpSync('src/migrations','dist/migrations',{recursive:true})})\"",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "migrate:prod": "node dist/migrate.js",
    "seed": "node dist/seed.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@mockza/config": "workspace:*",
    "@mockza/domain": "workspace:*",
    "drizzle-orm": "^0.43.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.1"
  }
}
