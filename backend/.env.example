# Server & Edition
NODE_ENV=development
PORT=8787
EDITION=glb

# PostgreSQL 16 (host non-colliding port 45432; PgBouncer transaction pool on 45433)
DATABASE_URL=postgres://mockza:mockza_dev_password@localhost:45432/mockza
PG_PGBOUNCER=false
PG_POOL_MAX=20
WORKER_CONCURRENCY=15

# Private Audio Object Storage (SeaweedFS S3 in dev/self-hosted or S3-compatible)
S3_ENDPOINT=http://localhost:45833
S3_PUBLIC_ENDPOINT=http://localhost:45833
S3_REGION=us-east-1
S3_BUCKET=mockza-audio-private
S3_MEDIA_BUCKET=mockza-media
S3_EXTRA_BUCKETS=mockza-media
S3_PUBLIC_MODE=proxy
S3_ACCESS_KEY=mockza_s3_access
S3_SECRET_KEY=mockza_s3_secret
ADMIN_API_KEY=mockza-dev-admin-key-change-me

# Auth & App Attestation
JWT_SECRET=replace-with-at-least-32-char-random-secret-key
APP_ATTEST_ENFORCED=false
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
SSE_ENABLED=false

# AI Routing & Observability
OPENROUTER_API_KEY=
OPENROUTER_NO_RETENTION=true
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Billing Webhooks (server-to-server truth only)
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
CAFEBAZAAR_SECRET=
MYKET_SECRET=

# Telemetry & Limits (ADR-010 / ADR-011)
POSTHOG_API_KEY=
MAX_AUDIO_MB=5
AUDIO_TTL_DAYS=30
