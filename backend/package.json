{
  "name": "mockza-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @mockza/api dev",
    "dev:worker": "pnpm --filter @mockza/worker dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "lint": "pnpm exec biome check .",
    "lint:fix": "pnpm exec biome check --write .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:generate": "pnpm --filter @mockza/db generate",
    "db:migrate": "pnpm --filter @mockza/db migrate",
    "db:migrate:prod": "pnpm --filter @mockza/db migrate:prod",
    "eval": "pnpm --filter @mockza/evals eval",
    "content:validate": "pnpm --filter @mockza/content-pipeline validate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
