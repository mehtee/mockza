# Mockza Container-First Stack Configuration (defaults safe & non-colliding)
COMPOSE_PROJECT_NAME=mockza

# Distribution edition: glb (Global) | irn (Iran)
MOCKZA_EDITION=glb

# Host ports chosen outside running Docker services (e.g. 5432, 8000, 8001, 59xxx)
MOCKZA_WEB_PORT=45280
MOCKZA_API_PORT=45281
MOCKZA_PG_PORT=45432
MOCKZA_PGBOUNCER_PORT=45433
MOCKZA_S3_PORT=45833
MOCKZA_S3_MASTER_PORT=45933

# PostgreSQL 16 credentials (container network)
POSTGRES_USER=mockza
POSTGRES_PASSWORD=mockza_dev_password
POSTGRES_DB=mockza

# SeaweedFS S3-compatible audio object storage
S3_BUCKET=mockza-audio-private
S3_REGION=us-east-1
S3_ACCESS_KEY=mockza_s3_access
S3_SECRET_KEY=mockza_s3_secret
S3_PUBLIC_ENDPOINT=http://127.0.0.1:45833

# CDN, Auth & Compliance limits (ADR-010 / ADR-011)
S3_MEDIA_BUCKET=mockza-media
S3_PUBLIC_MODE=proxy
ADMIN_API_KEY=mockza-dev-admin-key-change-me
JWT_SECRET=dev-insecure-replace-before-prod-32chars
APP_ATTEST_ENFORCED=false
# Dev-only OAuth sandbox (strictly forbidden when NODE_ENV=production).
# Set real client IDs below (comma-separated for Web, iOS, Android) to switch to real OIDC automatically.
ALLOW_DEV_AUTH_PROVIDERS=true
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
MAX_AUDIO_MB=5
AUDIO_TTL_DAYS=30

# External AI / Observability / Billing keys (optional in local mock/dev mode)
OPENROUTER_API_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
REVENUECAT_WEBHOOK_SECRET=
CAFEBAZAAR_SECRET=
MYKET_SECRET=
POSTHOG_API_KEY=

# Flutter Web / Native OAuth & build arguments (empty API base uses same-origin Nginx /v1 proxy)
MOCKZA_WEB_FLAVOR=global
MOCKZA_API_BASE_URL=
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=
